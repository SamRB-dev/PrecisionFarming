        <mxCell id="root_req" value="&lt;b&gt;SCENARIO SCOPE&lt;/b&gt;&lt;br&gt;Task coordination and safe weed removal&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;FR-04–FR-07 | SR-01–SR-07&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=17;spacingRight=12;strokeColor=#222222;fillColor=#FFFFFF;fontFamily=Arial;fontSize=19;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="332" y="137" width="516" height="111" as="geometry"/>
