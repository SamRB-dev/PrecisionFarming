        <mxCell id="sr_container" value="" style="rounded=1;html=1;strokeColor=#999999;fillColor=none;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="42" y="863" width="1096" height="798" as="geometry"/>
        </mxCell>
        <mxCell id="frhead" value="FUNCTIONAL REQUIREMENTS     FR-04—FR-07" style="rounded=0;html=1;align=left;verticalAlign=middle;spacingLeft=22;strokeColor=#333333;fillColor=#F6F6F6;fontFamily=Arial;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="62" y="310" width="1056" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="srhead" value="SAFETY REQUIREMENTS     SR-01—SR-07" style="rounded=0;html=1;align=left;verticalAlign=middle;spacingLeft=22;strokeColor=#333333;fillColor=#F6F6F6;fontFamily=Arial;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="62" y="883" width="1056" height="58" as="geometry"/>
        </mxCell>
        <mxCell id="FR-04" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FR-04 — Create and assign a task&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Create a unique task ID and target; assign to an available tractor." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="395" width="486" height="143" as="geometry"/>
        </mxCell>
        <mxCell id="FR-05" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FR-05 — Navigate and remove weed&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Validate the task, navigate, verify the treatment area, and perform removal." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="395" width="486" height="143" as="geometry"/>
        </mxCell>
        <mxCell id="FR-06" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FR-06 — Report task outcome&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Report completed, partial, or failed; Control Station records the status." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="567" width="486" height="143" as="geometry"/>
        </mxCell>
        <mxCell id="FR-07" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;FR-07 — Prevent duplicate assignment&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Prevent concurrent duplicate assignment; only finish once tasks have terminal outcomes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="567" width="486" height="143" as="geometry"/>
        </mxCell>
        <mxCell id="SR-01" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-01 — Obstacle / person protection&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Stop when an obstacle or person enters the defined safety zone." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="1025" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="SR-02" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-02 — Tool interlock&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Do not activate the removal mechanism while the tractor is moving." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="1025" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="SR-03" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-03 — Target verification&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Activate removal only after target and treatment-area verification." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="1189" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="SR-04" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-04 — Field-boundary containment&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Remain in the authorized field; stop if localization is unreliable." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="1189" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="SR-05" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-05 — Unavailable safety data&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Enter a defined safe state if critical data are unavailable or unreliable." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="1353" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="SR-06" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-06 — Emergency stop&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Halt tractor motion and disable the weed-removal mechanism." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="592" y="1353" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="SR-07" value="&amp;lt;&amp;lt;requirement&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SR-07 — Command validation&lt;/b&gt;&lt;br&gt;&lt;hr&gt;Reject invalid, expired, or unauthorized commands." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;strokeColor=#333333;fillColor=#FFFFFF;fontFamily=Arial;fontSize=18;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="82" y="1517" width="486" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="footer" value="Requirements grouped by function and safety; IDs follow the team’s Scenario 2 guide." style="text;html=1;align=center;strokeColor=none;fillColor=none;fontColor=#666666;fontFamily=Arial;fontSize=16;" vertex="1" parent="1">
